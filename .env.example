# MerMaid 백엔드 설정 (docs/controller/DATA_LOGGING.md §9). 이 파일을 .env로 복사해 값을 채운다.
# .env는 git에 올리지 않는다 (.gitignore). 길고 무작위인 값 만들기:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"

# ---- 공통 ----
# 필수. 모든 /api 요청의 X-API-Key 헤더 (/api/health 제외).
# 차 → 서버 업로드(server/tools/collect_logs.py)도 같은 값을 읽는다.
MERMAID_API_KEY=

# 업로드 한 번의 최대 크기 (MB)
MERMAID_MAX_UPLOAD_MB=1024

# ---- docker compose (compose.yaml) ----
#   docker compose up -d --build
# api의 DATABASE_URL, STORAGE_URL은 아래 값으로 compose가 만든다 (PostgreSQL + S3 호환 SeaweedFS).
# 비밀번호는 URL에 들어가므로 영문·숫자·-_ 만 쓴다 (token_urlsafe 결과는 괜찮다).
POSTGRES_DB=mermaid
POSTGRES_USER=mermaid
POSTGRES_PASSWORD=
S3_ACCESS_KEY=mermaid
S3_SECRET_KEY=
S3_BUCKET=mermaid
# 호스트에 여는 포트 (api만 연다. DB와 S3는 compose 안에서만)
MERMAID_PORT=8080

# ---- docker 없이 직접 실행 (저장소 루트에서) ----
#   set -a; . ./.env; set +a
#   uvicorn server.app:app --host 0.0.0.0 --port 8080
# 아래를 비우면 MERMAID_DATA 폴더 하나에 다 둔다: rides/ (주행 파일), mermaid.db (SQLite), incoming/
MERMAID_DATA=server/data
# 중앙 DB. 비우면 sqlite:///MERMAID_DATA/mermaid.db. 예: postgresql+psycopg://user:pw@localhost:5432/mermaid
DATABASE_URL=
# 주행 파일 저장소. 비우면 MERMAID_DATA 폴더. 예: s3://버킷/prefix (자격 증명은 AWS_* 환경 변수 또는 IAM 역할)
STORAGE_URL=
