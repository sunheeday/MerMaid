<?xml version="1.0" encoding="utf-8"?>
<!-- 멀미 점수 알림을 펼쳤을 때: 0~10을 알림에서 바로 고른다 (M08 SYM). 글자는 LinkService가 채운다 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/sym_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.Compat.Notification.Title" />

    <TextView
        android:id="@+id/sym_guide"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.Compat.Notification" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">
        <TextView android:id="@+id/sym_0" style="@style/SymCell" />
        <TextView android:id="@+id/sym_1" style="@style/SymCell" />
        <TextView android:id="@+id/sym_2" style="@style/SymCell" />
        <TextView android:id="@+id/sym_3" style="@style/SymCell" />
        <TextView android:id="@+id/sym_4" style="@style/SymCell" />
        <TextView android:id="@+id/sym_5" style="@style/SymCell" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView android:id="@+id/sym_6" style="@style/SymCell" />
        <TextView android:id="@+id/sym_7" style="@style/SymCell" />
        <TextView android:id="@+id/sym_8" style="@style/SymCell" />
        <TextView android:id="@+id/sym_9" style="@style/SymCell" />
        <TextView android:id="@+id/sym_10" style="@style/SymCell" />
        <!-- 윗줄(6칸)과 칸 너비를 맞추는 빈 칸 -->
        <FrameLayout
            android:id="@+id/sym_pad"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_margin="2dp"
            android:layout_weight="1" />
    </LinearLayout>
</LinearLayout>
