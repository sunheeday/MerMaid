<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="ic_launcher_background">#1E1B1D</color>
    <color name="paper">#F6F3F0</color>
    <style name="Theme.MerMaid" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <!-- 알림 속 멀미 점수 칸 (res/layout/notif_sym.xml) -->
    <style name="SymCell">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">2dp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/bg_sym_cell</item>
        <item name="android:textAppearance">@style/TextAppearance.Compat.Notification.Title</item>
    </style>
</resources>
