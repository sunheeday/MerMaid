{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mermaid/messages.schema.json",
  "title": "MerMaid BLE messages v1",
  "description": "JSON payload of one line. The 512-byte frame limit is checked by the sender, not by this schema.",
  "oneOf": [
    { "$ref": "#/$defs/HELLO" },
    { "$ref": "#/$defs/INT" },
    { "$ref": "#/$defs/MOT" },
    { "$ref": "#/$defs/SCR" },
    { "$ref": "#/$defs/OVR" },
    { "$ref": "#/$defs/PROF" },
    { "$ref": "#/$defs/HB" },
    { "$ref": "#/$defs/SYM" },
    { "$ref": "#/$defs/GPS" },
    { "$ref": "#/$defs/RISK" }
  ],
  "$defs": {
    "HELLO": {
      "description": "M00, device -> controller",
      "type": "object",
      "properties": {
        "t": { "const": "HELLO" },
        "role": { "enum": ["app", "hud"] },
        "dev": { "type": "string", "minLength": 1, "maxLength": 64 },
        "v": { "const": 1 }
      },
      "required": ["t", "role", "dev", "v"],
      "additionalProperties": false
    },
    "INT": {
      "description": "M01, controller -> device",
      "type": "object",
      "properties": {
        "t": { "const": "INT" },
        "tier": { "enum": [1, 2, 3] },
        "on": { "type": "boolean" }
      },
      "required": ["t", "tier", "on"],
      "additionalProperties": false
    },
    "MOT": {
      "description": "M02, controller -> device, 10 Hz, weighted acceleration in m/s^2. pax/pay only when a route preview exists",
      "type": "object",
      "properties": {
        "t": { "const": "MOT" },
        "ax": { "type": "number" },
        "ay": { "type": "number" },
        "pax": { "type": "number" },
        "pay": { "type": "number" }
      },
      "required": ["t", "ax", "ay"],
      "dependentRequired": { "pax": ["pay"], "pay": ["pax"] },
      "additionalProperties": false
    },
    "SCR": {
      "description": "M03, device -> controller. The HUD always sends att=false",
      "type": "object",
      "properties": {
        "t": { "const": "SCR" },
        "on": { "type": "boolean" },
        "att": { "type": "boolean" }
      },
      "required": ["t", "on", "att"],
      "additionalProperties": false
    },
    "OVR": {
      "description": "M05, device -> controller. dev is the target device: airflow-01, display-01, or a phone device ID. The sender is identified by its connection",
      "type": "object",
      "properties": {
        "t": { "const": "OVR" },
        "dev": { "type": "string", "minLength": 1, "maxLength": 64 },
        "on": { "type": "boolean" }
      },
      "required": ["t", "dev", "on"],
      "additionalProperties": false
    },
    "PROF": {
      "description": "M06, app <-> controller. MSSQ-Short raw score and survey sensitivity",
      "type": "object",
      "properties": {
        "t": { "const": "PROF" },
        "mssq": { "type": "number", "minimum": 0, "maximum": 54 },
        "sens": { "type": "number", "minimum": 0.5, "maximum": 2.0 }
      },
      "required": ["t", "mssq", "sens"],
      "additionalProperties": false
    },
    "HB": {
      "description": "M07, both directions, every 1 s",
      "type": "object",
      "properties": {
        "t": { "const": "HB" },
        "seq": { "type": "integer", "minimum": 0 }
      },
      "required": ["t", "seq"],
      "additionalProperties": false
    },
    "SYM": {
      "description": "M08, app -> controller. Self-reported sickness score (MISC 0-10, integer) by touch. Data collection only: logged by the controller, never used by the policy",
      "type": "object",
      "properties": {
        "t": { "const": "SYM" },
        "misc": { "type": "integer", "minimum": 0, "maximum": 10 }
      },
      "required": ["t", "misc"],
      "additionalProperties": false
    },
    "GPS": {
      "description": "M09, app -> controller, after HELLO, 1-10 Hz. Phone GPS speed (m/s), horizontal accuracy (m), optional bearing (deg) and altitude (m). No latitude/longitude",
      "type": "object",
      "properties": {
        "t": { "const": "GPS" },
        "spd": { "type": "number", "minimum": 0, "maximum": 100 },
        "acc": { "type": "number", "minimum": 0 },
        "brg": { "type": "number", "minimum": 0, "exclusiveMaximum": 360 },
        "alt": { "type": "number" }
      },
      "required": ["t", "spd", "acc"],
      "additionalProperties": false
    },
    "RISK": {
      "description": "M10, controller -> app, every inference period (10 s). This phone's P(MISC>=2), P(MISC>=3), ..., P(MISC>=6), 2 decimals. Display only",
      "type": "object",
      "properties": {
        "t": { "const": "RISK" },
        "p": {
          "type": "array",
          "items": { "type": "number", "minimum": 0, "maximum": 1 },
          "minItems": 5,
          "maxItems": 5
        }
      },
      "required": ["t", "p"],
      "additionalProperties": false
    }
  }
}
