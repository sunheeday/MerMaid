{
 "version": 1,
 "layout": "little-endian float64. Header of 3 values [version, n_columns, sample_rate_hz], then rows of n_columns at 100 Hz. Missing signal = NaN for the whole trip",
 "imu_convention": "accelerometer reads specific force (gravity included, +9.81 on z when level and still); x forward, y left, z up; gyro in rad/s",
 "columns": [
  {"name": "t", "unit": "s", "group": "clock"},
  {"name": "ax", "unit": "m/s^2", "group": "imu"},
  {"name": "ay", "unit": "m/s^2", "group": "imu"},
  {"name": "az", "unit": "m/s^2", "group": "imu"},
  {"name": "gx", "unit": "rad/s", "group": "imu"},
  {"name": "gy", "unit": "rad/s", "group": "imu"},
  {"name": "gz", "unit": "rad/s", "group": "imu"},
  {"name": "speed", "unit": "m/s", "group": "G2"},
  {"name": "accel_pedal", "unit": "0-1", "group": "G3a"},
  {"name": "brake_pedal", "unit": "0-1", "group": "G3a"},
  {"name": "drive_mode", "unit": "code", "group": "G3a"},
  {"name": "cruise_on", "unit": "bool", "group": "G3a"},
  {"name": "regen_decel", "unit": "m/s^2", "group": "G3b", "note": "deceleration provided by regenerative braking, >= 0"},
  {"name": "regen_level", "unit": "code", "group": "G3b"},
  {"name": "one_pedal", "unit": "bool", "group": "G3b"},
  {"name": "soc", "unit": "0-1", "group": "G3b"},
  {"name": "batt_power", "unit": "kW", "group": "G3b"},
  {"name": "motor_torque", "unit": "Nm", "group": "G3b"},
  {"name": "dist_next_turn", "unit": "m", "group": "G4"},
  {"name": "angle_next_turn", "unit": "rad", "group": "G4"},
  {"name": "pred_ax_10s", "unit": "m/s^2", "group": "G4"},
  {"name": "pred_ay_10s", "unit": "m/s^2", "group": "G4"},
  {"name": "curvature_ahead", "unit": "1/m", "group": "G4"},
  {"name": "cabin_temp", "unit": "degC", "group": "G5"},
  {"name": "set_temp", "unit": "degC", "group": "G5"},
  {"name": "fan_level", "unit": "code", "group": "G5"},
  {"name": "ac_on", "unit": "bool", "group": "G5"},
  {"name": "seat_row", "unit": "code", "group": "G6"},
  {"name": "seatback_angle", "unit": "deg", "group": "G6"},
  {"name": "window_open", "unit": "bool", "group": "G6"},
  {"name": "noise_level", "unit": "dB", "group": "G7"},
  {"name": "noise_lowfreq_level", "unit": "dB", "group": "G7"}
 ]
}
