# MerMaid 로그 서버 설정 (docs/controller/DATA_LOGGING.md §9)
# 이 파일을 server/.env로 복사해 값을 채운다. .env는 git에 올리지 않는다 (.gitignore).
#
# 실행 (저장소 루트에서):
#   set -a; . server/.env; set +a
#   uvicorn server.app:app --host 0.0.0.0 --port 8080
# 차 → 서버 업로드(server/tools/collect_logs.py)도 같은 MERMAID_API_KEY를 읽는다.

# 필수. 모든 /api 요청의 X-API-Key 헤더 (/api/health 제외). 길고 무작위인 값:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
MERMAID_API_KEY=

# 데이터 폴더: incoming/ (받는 중), rides/ (주행 파일 보관), mermaid.db (중앙 색인 DB). 비우면 server/data
MERMAID_DATA=server/data

# 업로드 한 번의 최대 크기 (MB)
MERMAID_MAX_UPLOAD_MB=1024
